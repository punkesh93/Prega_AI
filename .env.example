# ─────────────────────────────────────────────────────────────────────────────
# Prega AI — environment template
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed.
#
# The Secrets Gradle plugin turns each key below into a BuildConfig field.
# ─────────────────────────────────────────────────────────────────────────────

# OPENROUTER_API_KEY — powers every AI feature (coach, daily insight,
# meal plans, quests, notification copy). Get one at https://openrouter.ai/keys
#
# ⚠️  DO NOT SHIP A REAL KEY IN A RELEASE BUILD.
# Anything in BuildConfig is embedded in the APK and can be extracted in
# minutes. Before going to production, put the key behind a small backend
# proxy and point OpenRouterClient.BASE_URL at that instead.
OPENROUTER_API_KEY=MY_OPENROUTER_API_KEY

# GEMINI_API_KEY — legacy. Retained only so older builds keep compiling; the
# app now routes all AI through OpenRouter. Safe to remove once the Gemini
# client is deleted.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# ─── Anonymous aggregate stats (Airtable) ──────────────────────────────────
# Powers AppStats.kt — app opens, feature-usage counts. NEVER anything she
# typed or logged. See docs/index.html's privacy policy for the exact
# promise this keeps. Leave blank/placeholder to disable stats entirely;
# the app runs fine without it (AppStats.log() silently no-ops).
#
# AIRTABLE_TOKEN — Personal Access Token scoped to data.records:write on
# ONLY the one base below. Generate at https://airtable.com/create/tokens
#
# ⚠️  Same warning as OPENROUTER_API_KEY: this ships inside the APK and can
# be extracted. Because it's scoped to one base with write-only access to
# an anonymous stats table (never app data, which never leaves the device),
# the worst case of a leak is someone polluting the stats table — not a
# privacy incident. Still worth proxying before a real production release.
AIRTABLE_TOKEN=MY_AIRTABLE_TOKEN

# AIRTABLE_BASE_ID — starts with "app...", from the base's URL or API docs page.
AIRTABLE_BASE_ID=MY_AIRTABLE_BASE_ID

# AIRTABLE_TABLE — table name or ID (tbl...) inside that base.
AIRTABLE_TABLE=MY_AIRTABLE_TABLE
